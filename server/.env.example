# PostgreSQL connection string
# Local dev example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/callcenter
# Render (or any host) will give you this automatically when you
# create a PostgreSQL database there.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/callcenter

# Secret used to sign login sessions (JWT). Use a long random
# string in production — never reuse this example value.
JWT_SECRET=your_jwt_secret_key_here

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
# (your frontend's URL). Use * only for local development.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# One-time setup key used only by the first-admin bootstrap route.
SETUP_KEY=your_setup_key_here

# ---------------------------------------------------------
# MULTILINGUAL AI LLM PROVIDERS — OPTIONAL
# ---------------------------------------------------------
# Google Gemini (Free tier, top multilingual performance in Urdu, Hindi, Arabic, etc.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (Ultra-fast, Llama-3.3-70b)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------
# LOW-LATENCY REAL-TIME TTS PROVIDERS — OPTIONAL
# ---------------------------------------------------------
# ElevenLabs Turbo (Fastest streaming voice with direct ulaw_8000 support)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Deepgram Aura (Direct 8kHz mulaw telephony TTS, <200ms latency)
DEEPGRAM_API_KEY=

# ---------------------------------------------------------
# REAL TWILIO TELEPHONY — OPTIONAL
# ---------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public URL of your backend (required for Twilio webhooks, e.g. ngrok or Render URL)
PUBLIC_URL=http://localhost:4000
